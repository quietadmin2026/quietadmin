# Copy this file to .env.local and fill in your Google OAuth Web Client ID.
# Without it the app still runs fully on local (browser) storage; Drive sync stays disabled.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Supabase (multi-tenant backend). When both are set, the app uses Supabase for
# Google sign-in and per-therapist data; when absent it falls back to the legacy
# localStorage/Drive flow. The anon/publishable key is public and browser-safe —
# row-level security enforces per-therapist isolation on the server.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx_or_anon_jwt
